# CyberShield Example Environment
# Copy this file to .env and fill in ALL values before running.
# NEVER commit .env to version control.

POSTGRES_DB=cybershield
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
CYBERSHIELD_MONITOR_PATHS=./protected_folder
JWT_SECRET=REPLACE_WITH_RANDOM_256_BIT_SECRET
API_KEY=GENERATE_SECURE_API_KEY_HERE
NGROK_AUTHTOKEN=
