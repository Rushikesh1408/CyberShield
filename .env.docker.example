# Backend monitoring path inside container.
# Default in compose points to /app/protected_folder
CYBERSHIELD_MONITOR_PATHS=/app/protected_folder

# Optional: Command Center integration
CYBERSHIELD_COMMAND_CENTER_BASE_URL=
CYBERSHIELD_COMMAND_CENTER_API_KEY=
CYBERSHIELD_COMMAND_CENTER_SOURCE=cybershield-engine
CYBERSHIELD_COMMAND_CENTER_LOCATION=local-endpoint
CYBERSHIELD_COMMAND_CENTER_SYSTEM=CyberShield Protected Filesystem

# Optional: SMTP emergency email alerts
# You can use either the MAIL_* variables below or the CYBERSHIELD_SMTP_* aliases.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=true
MAIL_USE_SSL=false

CYBERSHIELD_SMTP_HOST=smtp.gmail.com
CYBERSHIELD_SMTP_PORT=587
CYBERSHIELD_SMTP_USERNAME=
CYBERSHIELD_SMTP_PASSWORD=
CYBERSHIELD_SMTP_FROM_EMAIL=
CYBERSHIELD_SMTP_USE_TLS=true

# Optional: ngrok tunnel
NGROK_AUTHTOKEN=

# Optional: host port mapping for frontend (container port 80)
CYBERSHIELD_FRONTEND_PORT=5173
